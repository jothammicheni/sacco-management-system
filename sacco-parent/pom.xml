<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>sacco-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>sacco-parent</name>
    <description>Parent POM for SACCO microservices</description>

    <modules>
        <module>../sacco-events</module>
        <module>../sacco-member-service</module>
        <module>../sacco-account-service</module>
<!--        <module>../sacco-loan-service</module>-->
<!--        <module>../sacco-notification-service</module>-->
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Central version control -->
        <sacco-events.version>1.0.0</sacco-events.version>
        <mysql-connector.version>8.4.0</mysql-connector.version>
    </properties>

    <!--
      Dependency management: any service that declares one of these
      dependencies can omit the <version> tag. The parent supplies it.
    -->
    <dependencyManagement>
        <dependencies>

            <!-- Shared event contracts -->
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>sacco-events</artifactId>
                <version>${sacco-events.version}</version>
            </dependency>

            <!-- MySQL driver -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Reproducible builds -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>